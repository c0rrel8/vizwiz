Gradient Position =
// ============================================================================
// WORKED EXAMPLE -- the single-dimension form of gradientposition.dax, with
// no field parameter. Kept in the repo so it stays in sync with the template
// whenever the engine changes; retarget it by editing the names in CONFIG B.
//
//   Dimension = 'Colortest'[Pos]      (the set of distinct values to color)
//   Sort col  = 'Colortest'[Sort]     (tie-break, and the "SORT" basis order)
//   Measure   = [Stepvalue]           (what drives the gradient)
//
// With one candidate there is nothing for SWITCH to pick between, so the
// four candidate blocks and every SWITCH in the template collapse to one
// member table and one rank. Everything else is identical -- same knobs,
// same engine, same semantics.
//
// gradientfillcolor.dax and gradientlabelcolor.dax take this measure
// unchanged. Rename all three together if the real measures are already in
// the model, or they will collide (model-wide measure namespace).
// ============================================================================

// ---------------------------------------------------------------------------
// CONFIG A -- behavior knobs.
// ---------------------------------------------------------------------------
VAR GradientBasis = "MEASURE" // "MEASURE" (order by [Stepvalue]) | "SORT" (order by [Sort])
VAR Spacing = "EQUAL"         // "EQUAL" (even per rank) | "VALUE" (by magnitude)
VAR TieBreak = "SORT"         // "SORT" (tied values split by [Sort]) | "NONE" (tied values share a color)
VAR ValueScale = "LINEAR"     // "LINEAR" | "LOG" -- only when Spacing = "VALUE"
VAR SortDirection = "ASC"     // "ASC" | "DESC"
VAR OutputScale = "UNIT"      // "UNIT" (0..1, for the color measures) | "RANK" (1..N)
VAR LogOffset = 1             // keeps LOG(0) from erroring when ValueScale = "LOG"

// --- SORT KEY TYPE -- get this wrong and the order is silently scrambled ---
// The sort key is packed into a TEXT ranking key (see "HOW TIES ARE BROKEN"
// below), and text puts "10" before "2". A NUMERIC sort column therefore has
// to be zero-padded first; a TEXT one must NOT be (padding a text value
// destroys its alphabetical order, since the padding is compared first).
//   TRUE  = 'Colortest'[Sort] holds numbers  -> zero-pad to SortKeyDigits
//   FALSE = 'Colortest'[Sort] holds text     -> use as-is
// SortKeyDigits must exceed the digit count of the largest sort value. If the
// sort column can go negative, add an offset to it in CONFIG B -- text sorts
// "-5" above "-20" for the same reason KeyOffset exists.
VAR SortKeyIsNumeric = TRUE
VAR SortKeyDigits = 12
VAR SortKeyFormat = REPT ( "0", SortKeyDigits )

// --- TIE-BREAK KEY PACKING ---
// Breaking a tie needs a strict total order over (measure value, sort key).
// The obvious way -- "count how many rows beat me" -- is O(N^2) and is what
// HANDOFF.md open item 1 blames for the high-cardinality crash. So both parts
// are packed into ONE sortable text key and ranked in a single RANKX pass.
// Zero-padding is what makes the text comparison agree with the numeric one
// ("0000000005.000" < "0000000020.000", where unpadded "5" > "20").
//   1. KeyIntDigits must exceed the digit count of the largest [Stepvalue].
//      At width 2, 90 packs to "90.000" and 300 to "300.000" -- and "3" < "9"
//      puts 300 before 90. Silent when it happens.
//   2. If [Stepvalue] can go negative, set KeyOffset to at least the absolute
//      value of the most negative it can reach.
//   3. Values are compared at KeyDecimals precision, so anything closer than
//      that counts as a tie. Usually a feature -- float noise stops inventing
//      orderings -- but raise it for a measure whose real differences live
//      further right of the decimal point.
VAR KeyOffset = 0
VAR KeyIntDigits = 12
VAR KeyDecimals = 3
VAR KeyFormat = REPT ( "0", KeyIntDigits ) & "." & REPT ( "0", KeyDecimals )

// ---------------------------------------------------------------------------
// CONFIG B -- dimension wiring. The only names to change.
// ---------------------------------------------------------------------------

// This member's own values, in the current filter context.
VAR CurMeasureValue = CALCULATE ( [Stepvalue] )
VAR CurSortKeyRaw = MAX ( 'Colortest'[Sort] )

// One row per distinct [Pos], carrying both ranking inputs.
// ALLSELECTED = the gradient rescales as slicers narrow the data; change it
// to ALL for a gradient fixed against the whole table regardless of slicers.
// NOTE the CALCULATE around MAX('Colortest'[Sort]): ALLSELECTED('Colortest'[Pos])
// is a ONE-COLUMN table, so [Sort] is not in row context and cannot be
// referenced bare. CALCULATE forces the context transition -- filter to this
// row's [Pos], then take its [Sort]. Keep this expression and CurSortKeyRaw
// above naming the same column.
VAR MemberBase =
    ADDCOLUMNS (
        ALLSELECTED ( 'Colortest'[Pos] ),
        "GradValueTemp", CALCULATE ( [Stepvalue] ),
        "SortKeyTemp", CALCULATE ( MAX ( 'Colortest'[Sort] ) )
    )

// ---------------------------------------------------------------------------
// ENGINE -- generic. No edits needed to retarget this measure.
// ---------------------------------------------------------------------------

// The sort key as ORDER-SAFE TEXT -- padded if numeric, untouched if not.
// Applied here rather than in MemberBase so SortKeyTemp stays in its native
// type, and applied to BOTH the "SORT" basis and the tie-break so a numeric
// sort column orders correctly in either.
// A separate ADDCOLUMNS from MemberBase because a column added in an
// ADDCOLUMNS cannot be referenced by a sibling column in the same one -- and
// doing it this way evaluates [Stepvalue] once per member, not twice.
// NAMED MemberTable, NOT Members -- Members is reserved (confirmed live).
VAR MemberTable =
    ADDCOLUMNS (
        MemberBase,
        "RankKeyTemp",
            VAR SortText =
                IF (
                    SortKeyIsNumeric,
                    FORMAT ( [SortKeyTemp], SortKeyFormat ),
                    [SortKeyTemp] & ""
                )
            RETURN
                SWITCH (
                    TRUE (),
                    GradientBasis = "SORT", SortText,
                    TieBreak = "SORT",
                        FORMAT ( [GradValueTemp] + KeyOffset, KeyFormat ) & "|" & SortText,
                    FORMAT ( [GradValueTemp] + KeyOffset, KeyFormat )
                )
    )

// The current member's key. MUST stay identical to the RankKeyTemp expression
// above -- one is evaluated per row, this one in the current filter context,
// and RANKX compares them directly. Change one, change both.
VAR CurSortKeyText =
    IF (
        SortKeyIsNumeric,
        FORMAT ( CurSortKeyRaw, SortKeyFormat ),
        CurSortKeyRaw & ""
    )
VAR CurRankKey =
    SWITCH (
        TRUE (),
        GradientBasis = "SORT", CurSortKeyText,
        TieBreak = "SORT",
            FORMAT ( CurMeasureValue + KeyOffset, KeyFormat ) & "|" & CurSortKeyText,
        FORMAT ( CurMeasureValue + KeyOffset, KeyFormat )
    )

VAR MemberCount = COUNTROWS ( MemberTable )
VAR KeyCount =
    COUNTROWS ( DISTINCT ( SELECTCOLUMNS ( MemberTable, "K", [RankKeyTemp] ) ) )
VAR MinValue = MINX ( MemberTable, [GradValueTemp] )
VAR MaxValue = MAXX ( MemberTable, [GradValueTemp] )

// DENSE, not SKIP: with TieBreak = "SORT" nothing ties so the two are
// identical, and with TieBreak = "NONE" DENSE is what keeps the ranks
// contiguous (1..KeyCount) so the last rank still lands on position 1 and
// HexEnd actually gets used. SKIP would leave 5/10/20/20 at ranks 1/2/3/3 out
// of 4 -- topping out at 0.67 and never reaching the end of the ramp.
// Named RankAsc, not Rank -- a bare "VAR Rank =" collides with the built-in
// RANK window function (confirmed live).
VAR RankAsc = RANKX ( MemberTable, [RankKeyTemp], CurRankKey, ASC, DENSE )

// Magnitude-spaced position (Spacing = "VALUE").
VAR ScaledMin = IF ( ValueScale = "LOG", LOG ( MinValue + LogOffset ), MinValue )
VAR ScaledMax = IF ( ValueScale = "LOG", LOG ( MaxValue + LogOffset ), MaxValue )
VAR ScaledCur = IF ( ValueScale = "LOG", LOG ( CurMeasureValue + LogOffset ), CurMeasureValue )
VAR PosByValue =
    IF (
        ScaledMax = ScaledMin,
        0.5, // every member has the same value -- park them mid-gradient
        DIVIDE ( ScaledCur - ScaledMin, ScaledMax - ScaledMin )
    )

// Rank-spaced position. Divides by KeyCount, not MemberCount -- that is what
// keeps both ends of the ramp in use when tied members share a rank.
VAR PosByRank =
    IF (
        KeyCount <= 1,
        0.5, // one member, or every member tied -- nothing to space against
        DIVIDE ( RankAsc - 1, KeyCount - 1 )
    )

VAR PosAsc =
    IF (
        GradientBasis = "MEASURE" && Spacing = "VALUE",
        PosByValue,
        PosByRank
    )

// Apply direction, then clamp -- the color measures assume a hard 0..1.
VAR PosDirected = IF ( SortDirection = "DESC", 1 - PosAsc, PosAsc )
VAR PositionOut = MIN ( 1, MAX ( 0, PosDirected ) )

// Rank, direction applied, for OutputScale = "RANK".
VAR RankOut = IF ( SortDirection = "DESC", KeyCount + 1 - RankAsc, RankAsc )

RETURN
    // BLANK in, BLANK out: a member with no measure value gets no position,
    // and the fill measure turns that into its fallback color rather than a
    // misleading mid-gradient shade. HASONEVALUE also blanks the TOTAL row of
    // a table/matrix visual -- without it the total inherits whichever member
    // MAX happens to land on and shows a meaningless color swatch. Deneb has
    // no total row, so this only matters when eyeballing the measure in a
    // table; drop it if a total-row color is actually wanted.
    IF (
        NOT HASONEVALUE ( 'Colortest'[Pos] )
            || ( ISBLANK ( CurMeasureValue ) && GradientBasis = "MEASURE" ),
        BLANK (),
        IF (
            OutputScale = "RANK",
            RankOut,
            IF ( MemberCount = 0, BLANK (), PositionOut )
        )
    )
