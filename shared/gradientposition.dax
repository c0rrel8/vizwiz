Gradient Position =
// ============================================================================
// SHARED BASE MEASURE -- 1 of 3. Paste all three, in this order:
//   1. gradientposition.dax    (this file)  -> numeric 0..1 (or 1..N) position
//   2. gradientfillcolor.dax                -> hex fill color
//   3. gradientlabelcolor.dax               -> hex text/label color
//
// This measure does ALL the heavy lifting: it resolves which column the
// dimension's field parameter currently points at, counts that dimension's
// distinct members in the current filter context, ranks the current member
// 1..N, and returns where that member sits along the gradient as a number
// between 0 (= HexStart end) and 1 (= HexEnd end).
//
// The two color measures are deliberately thin wrappers around this one, so
// there is exactly ONE place that has to know about the field parameter and
// its candidate columns. Do not duplicate that logic into them.
//
// RENAME PER VISUAL. Measure names are a single model-wide namespace in this
// model (see CLAUDE.md), so all three measures need a per-visual prefix --
// e.g. "Waffle Gradient Position", "Waffle Gradient Fill Color", "Waffle
// Gradient Label Color". If you rename this one, update the [Gradient
// Position] reference inside gradientfillcolor.dax to match.
//
// EDITING RULE: everything you normally need to change lives in CONFIG A and
// CONFIG B below. The ENGINE section underneath is generic -- it should not
// need editing to retarget this measure at a new visual, dimension, or
// gradient.
// ============================================================================

// ---------------------------------------------------------------------------
// CONFIG A -- behavior knobs. Edit freely; all are plain scalars.
// ---------------------------------------------------------------------------

// What drives the gradient?
//   "MEASURE" = order/scale members by a numeric measure (biggest gets the
//               HexEnd end of the gradient when SortDirection = "ASC").
//   "SORT"    = order members by a sort column instead (alphabetical, or an
//               explicit order column). Ignores the measure entirely.
VAR GradientBasis = "MEASURE"

// How are colors spaced across the members? (only used when
// GradientBasis = "MEASURE" -- "SORT" is always evenly spaced)
//   "EQUAL" = evenly spaced by RANK. Every member is one equal step from the
//             next regardless of how far apart the underlying values are.
//             Best for skewed data -- this is the safe default.
//   "VALUE" = spaced by MAGNITUDE. A member 4% of the way from min to max
//             gets a color 4% of the way along the gradient.
VAR Spacing = "EQUAL"

// What happens when two members have the SAME measure value.
//   "SORT" = break the tie with the sort column, giving a strict total order:
//            every member gets its own distinct color, and ranks always run
//            1..N with no gaps. See "HOW TIES ARE BROKEN" below for the
//            mechanism and its two real constraints (KeyIntDigits/KeyOffset).
//   "NONE" = tied members share a rank and therefore share a color. Ranks run
//            1..(distinct value count), so both ends of the ramp are still
//            used even when the tie is at the top.
// Only affects GradientBasis = "MEASURE" with Spacing = "EQUAL". Magnitude
// spacing has no ties to break, and "SORT" basis is already a total order.
VAR TieBreak = "SORT"

// Only used when Spacing = "VALUE".
//   "LINEAR" = straight min..max interpolation.
//   "LOG"    = log-scaled, for right-skewed measures where a few large
//              outliers would otherwise squash everything else against the
//              HexStart end. Assumes the measure is >= 0 (see LogOffset).
VAR ValueScale = "LINEAR"

// Which end of the gradient the "first" member lands on.
//   "ASC"  = lowest measure value / first sort value -> position 0 (HexStart);
//            highest / last -> position 1 (HexEnd).
//   "DESC" = reversed.
VAR SortDirection = "ASC"

// What this measure returns.
//   "UNIT" = 0..1 position. REQUIRED by the two color measures.
//   "RANK" = 1..N integer rank, for using this measure on its own in a native
//            Power BI conditional-formatting "gradient by field value" rule
//            (set the rule's Minimum to 1 and Maximum to your member count,
//            or leave both on Automatic). The color measures will produce
//            wrong output if you leave this on "RANK" -- if you need both,
//            duplicate this measure under a second name.
VAR OutputScale = "UNIT"

// Added inside LOG() to keep LOG(0) from erroring when ValueScale = "LOG".
// Only raise this if the measure can go negative -- e.g. set it to
// 1 - (most negative possible value).
VAR LogOffset = 1

// ---------------------------------------------------------------------------
// SORT KEY TYPE -- get this wrong and the order is silently scrambled
// ---------------------------------------------------------------------------
// The sort key is packed into a TEXT ranking key (see below), and text puts
// "10" before "2". A NUMERIC sort column therefore has to be zero-padded
// first; a TEXT one must NOT be (padding a text value destroys its
// alphabetical order, since the padding is compared first).
//   TRUE  = the sort column holds numbers -> zero-pad to SortKeyDigits
//   FALSE = the sort column holds text    -> use as-is
// FALSE is the default because the shipped sort key IS the dimension column
// itself, and all four candidates here are text. Flip it to TRUE the moment
// you repoint SortKeyTemp at a numeric order column -- this exact mistake
// reordered a 20-member test set as 1, 10, 11 ... 19, 2, 20, 3 ... 9 and
// looked like a gradient bug rather than a sort bug.
// SortKeyDigits must exceed the digit count of the largest sort value. If the
// sort column can go negative, add an offset to it in CONFIG B -- text sorts
// "-5" above "-20" for the same reason KeyOffset exists.
VAR SortKeyIsNumeric = FALSE
VAR SortKeyDigits = 12
VAR SortKeyFormat = REPT ( "0", SortKeyDigits )

// ---------------------------------------------------------------------------
// HOW TIES ARE BROKEN -- read before changing KeyIntDigits/KeyDecimals/KeyOffset
// ---------------------------------------------------------------------------
// Breaking a tie needs a strict total order over (measure value, sort key).
// The obvious way to get one -- "count how many rows beat me", as the older
// per-visual measures do -- is O(N^2) and is what HANDOFF.md open item 1
// blames for the high-cardinality crash. So instead both parts are packed
// into ONE sortable text key and ranked in a single RANKX pass:
//
//     FORMAT ( value, "000000000000.000" ) & "|" & sortkey
//
// Zero-padding to a fixed width is what makes the text comparison agree with
// the numeric one ("0000000005.000" < "0000000020.000", where the unpadded
// "5" > "20"). Three consequences you have to respect:
//
//   1. KeyIntDigits MUST exceed the digit count of your largest possible
//      measure value. Overflow past the padding width silently mis-orders.
//   2. Negative values sort backwards among themselves ("-5" > "-20" as text).
//      If the measure can go negative, set KeyOffset to at least the absolute
//      value of the most negative it can reach, so every key is >= 0.
//   3. Values are compared at KeyDecimals precision -- anything closer than
//      that counts as a tie. That is usually a feature (float noise stops
//      inventing orderings) but raise it for a measure whose real differences
//      live further right of the decimal point.
//
// The sort key half of the packed key is handled by SortKeyIsNumeric above,
// not here -- see that block.
VAR KeyOffset = 0
VAR KeyIntDigits = 12
VAR KeyDecimals = 3
VAR KeyFormat = REPT ( "0", KeyIntDigits ) & "." & REPT ( "0", KeyDecimals )

// ---------------------------------------------------------------------------
// CONFIG B -- dimension wiring. One block per field-parameter candidate.
// ---------------------------------------------------------------------------
//
// WHY THIS IS REPETITIVE: DAX cannot dynamically dereference "whichever
// column the field parameter currently points at" -- see
// aster/measureacolorgradient.dax for the full writeup (composite-key
// constraint, why MAX and not SELECTEDVALUE, why SWITCH may only branch
// between already-computed SCALARS, never between tables). So each candidate
// column gets its own block of plain scalar variables computed up front, and
// SWITCH picks between those scalars at the end.
//
// TO RETARGET THIS MEASURE AT ANOTHER VISUAL, in this section only:
//   1. Point SelectedField at that visual's own field parameter + label col:
//        'MappedParameter'[Category]        -- Level 1 / aster Category
//        'MappedParameterTwo'[Category2]    -- Level 2 / waffle Category  (CONFIRMED live)
//        'MappedParameterThree'[Category3]  -- Level 3  (column name NOT confirmed live)
//   2. Search/replace [Data Recieved GB] with your own gradient measure
//      (5 occurrences: 1 hoisted below + 1 per candidate block).
//   3. Add/remove a whole candidate block, plus its matching line in each
//      SWITCH in the ENGINE section, for every candidate added/removed from
//      the field parameter itself. Keep this list in sync with the field
//      parameter's own .dax file.
//
// NOT USING A FIELD PARAMETER? Set UseFieldParameter = FALSE, put the one
// column's name in FixedCandidate, and delete the candidate blocks you don't
// need (along with their SWITCH lines). If the model has no field parameter
// table at all, also replace the MAX(...) below with "" so the measure still
// compiles.
VAR UseFieldParameter = TRUE
VAR FixedCandidate = "EngagementCodeList"
VAR SelectedField =
    IF (
        UseFieldParameter,
        MAX ( 'MappedParameterTwo'[Category2] ),
        FixedCandidate
    )

// The gradient measure evaluated in the CURRENT row's filter context (i.e.
// this member's own value). Filter context is the same whichever candidate is
// selected, so this is hoisted out of the per-candidate blocks.
VAR CurMeasureValue = CALCULATE ( [Data Recieved GB] )

// --- Candidate block template -------------------------------------------
// Copy a block, then search/replace the column name in all 5 places.
// MemberBase_X  : one row per distinct member of this column, in the CURRENT
//               filter context (ALLSELECTED = the gradient rescales as
//               slicers narrow the data). To make the gradient absolute --
//               fixed against the whole model regardless of slicers -- change
//               ALLSELECTED to ALL in every candidate block.
//               If the SORT COLUMN IS NOT THE DIMENSION COLUMN, SortKeyTemp
//               must be wrapped in CALCULATE:
//                   "SortKeyTemp", CALCULATE ( MAX ( 'T'[OrderCol] ) )
//               ALLSELECTED(col) is a ONE-COLUMN table, so any other column is
//               not in row context and cannot be referenced bare; CALCULATE
//               forces the context transition. The default below needs no
//               CALCULATE only because it names the column already in the
//               table. Leave the column in its NATIVE TYPE here -- any
//               padding a numeric order column needs is applied later, in the
//               engine, via SortKeyIsNumeric.
// MemberTable_X : MemberBase_X plus the packed ranking key. A separate
//               ADDCOLUMNS because a column added in an ADDCOLUMNS cannot be
//               referenced by a sibling column in the same one -- and doing it
//               this way evaluates the measure once per member, not twice.
//               The RankKeyTemp expression is identical in every candidate
//               block (it names no real columns), so copy it verbatim.
//               NAMED MemberTable_X, NOT Members_X -- a bare "VAR Members ="
//               is rejected; the word is reserved (confirmed live by the
//               report author). Same class of finding as the bare
//               "VAR Rank =" collision documented in
//               waffle/categorycolorgradientrank.dax. Do not shorten it to a
//               bare Members when collapsing this measure to one dimension.
// MemberCount_X : distinct member count of the dimension itself.
// KeyCount_X  : distinct RANKING KEY count -- equal to MemberCount_X when
//               TieBreak = "SORT" (every key unique), and equal to the
//               distinct measure-value count when TieBreak = "NONE". This,
//               not MemberCount_X, is what the even spacing divides by, which
//               is what keeps both ends of the ramp in use when tied members
//               share a rank.
// MinV_X/MaxV_X : that column's lowest/highest measure value, for magnitude
//               spacing. Computed here, as scalars, rather than as MINX/MAXX
//               inside a SWITCH branch further down -- SWITCH is only reliable
//               when every branch is an already-computed scalar.
// SortKey_X   : this member's own value of the sort column, in the current
//               context. Must name the same column as SortKeyTemp above.
// -------------------------------------------------------------------------

VAR MemberBase_EngagementCodeList =
    ADDCOLUMNS (
        ALLSELECTED ( 'Project_snapshot_Fact'[EngagementCodeList] ),
        "GradValueTemp", CALCULATE ( [Data Recieved GB] ),
        "SortKeyTemp", 'Project_snapshot_Fact'[EngagementCodeList]
    )
VAR MemberTable_EngagementCodeList =
    ADDCOLUMNS (
        MemberBase_EngagementCodeList,
        "RankKeyTemp",
            VAR SortText =
                IF (
                    SortKeyIsNumeric,
                    FORMAT ( [SortKeyTemp], SortKeyFormat ),
                    [SortKeyTemp] & ""
                )
            RETURN
                SWITCH (
                    TRUE (),
                    GradientBasis = "SORT", SortText,
                    TieBreak = "SORT",
                        FORMAT ( [GradValueTemp] + KeyOffset, KeyFormat ) & "|" & SortText,
                    FORMAT ( [GradValueTemp] + KeyOffset, KeyFormat )
                )
    )
VAR MemberCount_EngagementCodeList = COUNTROWS ( MemberTable_EngagementCodeList )
VAR KeyCount_EngagementCodeList =
    COUNTROWS ( DISTINCT ( SELECTCOLUMNS ( MemberTable_EngagementCodeList, "K", [RankKeyTemp] ) ) )
VAR MinV_EngagementCodeList = MINX ( MemberTable_EngagementCodeList, [GradValueTemp] )
VAR MaxV_EngagementCodeList = MAXX ( MemberTable_EngagementCodeList, [GradValueTemp] )
VAR SortKey_EngagementCodeList = MAX ( 'Project_snapshot_Fact'[EngagementCodeList] )

VAR MemberBase_AlphaCode =
    ADDCOLUMNS (
        ALLSELECTED ( 'Project_snapshot_Fact'[AlphaCode] ),
        "GradValueTemp", CALCULATE ( [Data Recieved GB] ),
        "SortKeyTemp", 'Project_snapshot_Fact'[AlphaCode]
    )
VAR MemberTable_AlphaCode =
    ADDCOLUMNS (
        MemberBase_AlphaCode,
        "RankKeyTemp",
            VAR SortText =
                IF (
                    SortKeyIsNumeric,
                    FORMAT ( [SortKeyTemp], SortKeyFormat ),
                    [SortKeyTemp] & ""
                )
            RETURN
                SWITCH (
                    TRUE (),
                    GradientBasis = "SORT", SortText,
                    TieBreak = "SORT",
                        FORMAT ( [GradValueTemp] + KeyOffset, KeyFormat ) & "|" & SortText,
                    FORMAT ( [GradValueTemp] + KeyOffset, KeyFormat )
                )
    )
VAR MemberCount_AlphaCode = COUNTROWS ( MemberTable_AlphaCode )
VAR KeyCount_AlphaCode =
    COUNTROWS ( DISTINCT ( SELECTCOLUMNS ( MemberTable_AlphaCode, "K", [RankKeyTemp] ) ) )
VAR MinV_AlphaCode = MINX ( MemberTable_AlphaCode, [GradValueTemp] )
VAR MaxV_AlphaCode = MAXX ( MemberTable_AlphaCode, [GradValueTemp] )
VAR SortKey_AlphaCode = MAX ( 'Project_snapshot_Fact'[AlphaCode] )

VAR MemberBase_CustodianDisplayName =
    ADDCOLUMNS (
        ALLSELECTED ( 'Project_snapshot_Fact'[CustodianDisplayName] ),
        "GradValueTemp", CALCULATE ( [Data Recieved GB] ),
        "SortKeyTemp", 'Project_snapshot_Fact'[CustodianDisplayName]
    )
VAR MemberTable_CustodianDisplayName =
    ADDCOLUMNS (
        MemberBase_CustodianDisplayName,
        "RankKeyTemp",
            VAR SortText =
                IF (
                    SortKeyIsNumeric,
                    FORMAT ( [SortKeyTemp], SortKeyFormat ),
                    [SortKeyTemp] & ""
                )
            RETURN
                SWITCH (
                    TRUE (),
                    GradientBasis = "SORT", SortText,
                    TieBreak = "SORT",
                        FORMAT ( [GradValueTemp] + KeyOffset, KeyFormat ) & "|" & SortText,
                    FORMAT ( [GradValueTemp] + KeyOffset, KeyFormat )
                )
    )
VAR MemberCount_CustodianDisplayName = COUNTROWS ( MemberTable_CustodianDisplayName )
VAR KeyCount_CustodianDisplayName =
    COUNTROWS ( DISTINCT ( SELECTCOLUMNS ( MemberTable_CustodianDisplayName, "K", [RankKeyTemp] ) ) )
VAR MinV_CustodianDisplayName = MINX ( MemberTable_CustodianDisplayName, [GradValueTemp] )
VAR MaxV_CustodianDisplayName = MAXX ( MemberTable_CustodianDisplayName, [GradValueTemp] )
VAR SortKey_CustodianDisplayName = MAX ( 'Project_snapshot_Fact'[CustodianDisplayName] )

VAR MemberBase_EFileName =
    ADDCOLUMNS (
        ALLSELECTED ( 'Project_snapshot_Fact'[EFileName] ),
        "GradValueTemp", CALCULATE ( [Data Recieved GB] ),
        "SortKeyTemp", 'Project_snapshot_Fact'[EFileName]
    )
VAR MemberTable_EFileName =
    ADDCOLUMNS (
        MemberBase_EFileName,
        "RankKeyTemp",
            VAR SortText =
                IF (
                    SortKeyIsNumeric,
                    FORMAT ( [SortKeyTemp], SortKeyFormat ),
                    [SortKeyTemp] & ""
                )
            RETURN
                SWITCH (
                    TRUE (),
                    GradientBasis = "SORT", SortText,
                    TieBreak = "SORT",
                        FORMAT ( [GradValueTemp] + KeyOffset, KeyFormat ) & "|" & SortText,
                    FORMAT ( [GradValueTemp] + KeyOffset, KeyFormat )
                )
    )
VAR MemberCount_EFileName = COUNTROWS ( MemberTable_EFileName )
VAR KeyCount_EFileName =
    COUNTROWS ( DISTINCT ( SELECTCOLUMNS ( MemberTable_EFileName, "K", [RankKeyTemp] ) ) )
VAR MinV_EFileName = MINX ( MemberTable_EFileName, [GradValueTemp] )
VAR MaxV_EFileName = MAXX ( MemberTable_EFileName, [GradValueTemp] )
VAR SortKey_EFileName = MAX ( 'Project_snapshot_Fact'[EFileName] )

// ---------------------------------------------------------------------------
// ENGINE -- generic. Only edit to add/remove a candidate's SWITCH line.
// ---------------------------------------------------------------------------

// This member's own sort key, collapsed to the selected candidate. Needed
// before the ranking key can be built, which is why this SWITCH sits above
// the rest of them.
VAR CurSortKey =
    SWITCH (
        SelectedField,
        "EngagementCodeList", SortKey_EngagementCodeList,
        "AlphaCode", SortKey_AlphaCode,
        "CustodianDisplayName", SortKey_CustodianDisplayName,
        "EFileName", SortKey_EFileName
    )

// The current member's ranking key. MUST stay identical to the RankKeyTemp
// expression in the candidate blocks -- one is evaluated per row of the member
// table, this one in the current filter context, and RANKX compares them
// directly. Change one, change all of them.
VAR CurSortKeyText =
    IF (
        SortKeyIsNumeric,
        FORMAT ( CurSortKey, SortKeyFormat ),
        CurSortKey & ""
    )
VAR CurRankKey =
    SWITCH (
        TRUE (),
        GradientBasis = "SORT", CurSortKeyText,
        TieBreak = "SORT",
            FORMAT ( CurMeasureValue + KeyOffset, KeyFormat ) & "|" & CurSortKeyText,
        FORMAT ( CurMeasureValue + KeyOffset, KeyFormat )
    )

// One RANKX per candidate, all against the same shared key. DENSE, not SKIP:
// with TieBreak = "SORT" nothing ties so the two are identical, and with
// TieBreak = "NONE" DENSE is what keeps the ranks contiguous (1..KeyCount) so
// the last rank still lands on position 1 and HexEnd actually gets used.
// SKIP would leave 5/10/20/20 at ranks 1/2/3/3 out of 4 -- topping out at
// 0.67 and never reaching the end of the ramp.
VAR Rank_EngagementCodeList =
    RANKX ( MemberTable_EngagementCodeList, [RankKeyTemp], CurRankKey, ASC, DENSE )
VAR Rank_AlphaCode =
    RANKX ( MemberTable_AlphaCode, [RankKeyTemp], CurRankKey, ASC, DENSE )
VAR Rank_CustodianDisplayName =
    RANKX ( MemberTable_CustodianDisplayName, [RankKeyTemp], CurRankKey, ASC, DENSE )
VAR Rank_EFileName =
    RANKX ( MemberTable_EFileName, [RankKeyTemp], CurRankKey, ASC, DENSE )

// Collapse the remaining per-candidate scalars down to the selected candidate.
// SWITCH over already-computed scalars only -- never over tables.
VAR MemberCount =
    SWITCH (
        SelectedField,
        "EngagementCodeList", MemberCount_EngagementCodeList,
        "AlphaCode", MemberCount_AlphaCode,
        "CustodianDisplayName", MemberCount_CustodianDisplayName,
        "EFileName", MemberCount_EFileName
    )
VAR KeyCount =
    SWITCH (
        SelectedField,
        "EngagementCodeList", KeyCount_EngagementCodeList,
        "AlphaCode", KeyCount_AlphaCode,
        "CustodianDisplayName", KeyCount_CustodianDisplayName,
        "EFileName", KeyCount_EFileName
    )
VAR MinValue =
    SWITCH (
        SelectedField,
        "EngagementCodeList", MinV_EngagementCodeList,
        "AlphaCode", MinV_AlphaCode,
        "CustodianDisplayName", MinV_CustodianDisplayName,
        "EFileName", MinV_EFileName
    )
VAR MaxValue =
    SWITCH (
        SelectedField,
        "EngagementCodeList", MaxV_EngagementCodeList,
        "AlphaCode", MaxV_AlphaCode,
        "CustodianDisplayName", MaxV_CustodianDisplayName,
        "EFileName", MaxV_EFileName
    )

// Named RankAsc, not Rank -- a bare "VAR Rank =" is a syntax error, because
// DAX now has a built-in RANK window function that the name collides with
// (confirmed live, see waffle/categorycolorgradientrank.dax).
VAR RankAsc =
    SWITCH (
        SelectedField,
        "EngagementCodeList", Rank_EngagementCodeList,
        "AlphaCode", Rank_AlphaCode,
        "CustodianDisplayName", Rank_CustodianDisplayName,
        "EFileName", Rank_EFileName
    )

// Magnitude-spaced position (Spacing = "VALUE").
VAR ScaledMin = IF ( ValueScale = "LOG", LOG ( MinValue + LogOffset ), MinValue )
VAR ScaledMax = IF ( ValueScale = "LOG", LOG ( MaxValue + LogOffset ), MaxValue )
VAR ScaledCur = IF ( ValueScale = "LOG", LOG ( CurMeasureValue + LogOffset ), CurMeasureValue )
VAR PosByValue =
    IF (
        ScaledMax = ScaledMin,
        0.5, // every member has the same value -- park them mid-gradient
        DIVIDE ( ScaledCur - ScaledMin, ScaledMax - ScaledMin )
    )

// Rank-spaced position (Spacing = "EQUAL", and always for GradientBasis =
// "SORT"). Rank 1 -> 0, last rank -> 1, equal steps in between. Divides by
// KeyCount, not MemberCount -- see the KeyCount_X note in CONFIG B.
VAR PosByRank =
    IF (
        KeyCount <= 1,
        0.5, // one member, or every member tied -- nothing to space against
        DIVIDE ( RankAsc - 1, KeyCount - 1 )
    )

VAR PosAsc =
    IF (
        GradientBasis = "MEASURE" && Spacing = "VALUE",
        PosByValue,
        PosByRank
    )

// Apply direction, then clamp -- the color measures assume a hard 0..1.
VAR PosDirected = IF ( SortDirection = "DESC", 1 - PosAsc, PosAsc )
VAR PositionOut = MIN ( 1, MAX ( 0, PosDirected ) )

// Rank, direction applied, for OutputScale = "RANK".
VAR RankOut = IF ( SortDirection = "DESC", KeyCount + 1 - RankAsc, RankAsc )

RETURN
    // BLANK in, BLANK out: a member with no measure value gets no position,
    // and the fill measure turns that into its fallback color rather than a
    // misleading mid-gradient shade. MemberCount is referenced here so the
    // variable is not dead code -- it is the honest "distinct members of the
    // dimension" count, which KeyCount only equals when TieBreak = "SORT".
    IF (
        ISBLANK ( CurMeasureValue ) && GradientBasis = "MEASURE",
        BLANK (),
        IF (
            OutputScale = "RANK",
            RankOut,
            IF ( MemberCount = 0, BLANK (), PositionOut )
        )
    )
